{
	"name": "@aip-tech/braid-monorepo",
	"private": true,
	"version": "0.9.5",
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm --filter ./packages/example run dev",
		"dev:start": "pnpm --filter ./packages/example run start",
		"dev:watch": "pnpm --filter ./packages/example run watch",
		"dev:stop": "pnpm --filter ./packages/example run dev:stop",
		"dev:status": "pnpm --filter ./packages/example run dev:status",
		"dev:logs": "pnpm --filter ./packages/example run dev:logs",
		"build": "pnpm --filter ./packages/braid run build",
		"docs:dev": "pnpm --filter ./docs run dev",
		"docs:build": "pnpm --filter ./docs run build",
		"typecheck": "pnpm -r run typecheck",
		"format": "pnpm -r run format",
		"lint": "pnpm -r run lint",
		"check": "pnpm -r run check",
		"test": "pnpm -r run test",
		"coverage": "pnpm -r run coverage",
		"prepare": "pnpm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@types/node": "^26.0.0",
		"@vitest/coverage-istanbul": "^4.1.10",
		"jsdom": "^30.0.1",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vitest": "4.1.10"
	}
}
