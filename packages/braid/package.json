{
	"name": "@aip-tech/braid",
	"version": "0.1.0",
	"description": "Runs multiple long-lived processes as one unit — PID tracking, nodemon-driven restarts, and kill-everything-on-crash.",
	"license": "MIT",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aip-tech/braid.git"
	},
	"keywords": [
		"process-manager",
		"process-supervisor",
		"nodemon",
		"monorepo",
		"dev-tools",
		"cli"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"format": "biome format --write",
		"lint": "biome lint --write",
		"check": "biome check --write",
		"test": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"nodemon": "^3.1.14",
		"tree-kill": "^1.2.2"
	}
}
