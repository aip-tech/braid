{
	"name": "@aip-tech/braid",
	"version": "0.10.0",
	"description": "Run every process your project needs as one stack: restarts on file changes, dependencies between processes, crash handling, persistent logs and real per-app CPU and memory, from one config file.",
	"license": "MIT",
	"homepage": "https://aip-tech.github.io/braid",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"braid": "dist/cli.js"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aip-tech/braid.git",
		"directory": "packages/braid"
	},
	"keywords": [
		"process-manager",
		"process-supervisor",
		"file-watcher",
		"monorepo",
		"dev-tools",
		"cli"
	],
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"check": "biome check --write",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"chokidar": "^3.6.0",
		"import-meta-resolve": "^4.1.0",
		"sonic-boom": "^5.0.0",
		"tree-kill": "^1.2.2"
	}
}
