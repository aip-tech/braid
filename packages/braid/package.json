{
	"name": "@aip-tech/braid",
	"version": "0.1.0",
	"description": "Runs multiple long-lived processes as one unit — PID tracking, nodemon-driven restarts, and kill-everything-on-crash.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"braid": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aip-tech/braid.git"
	},
	"keywords": [
		"process-manager",
		"process-supervisor",
		"nodemon",
		"monorepo",
		"dev-tools",
		"cli"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"check": "biome check --write",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"nodemon": "^3.1.14",
		"tree-kill": "^1.2.2"
	}
}
