{
	"name": "@aip-tech/braid-example",
	"version": "0.0.0",
	"private": true,
	"description": "Live test bed for braid: starts a couple of toy processes via the workspace-local braid source.",
	"type": "module",
	"scripts": {
		"dev": "braid start",
		"watch": "braid start --foreground",
		"dev:stop": "braid stop",
		"dev:status": "braid status",
		"dev:logs": "braid logs --follow",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"check": "biome check --write"
	},
	"dependencies": {
		"@aip-tech/braid": "workspace:*"
	}
}
