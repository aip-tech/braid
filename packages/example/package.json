{
	"name": "braid-example",
	"version": "0.0.0",
	"private": true,
	"description": "Live test bed for braid: starts a couple of toy processes via the workspace-local braid source.",
	"type": "module",
	"scripts": {
		"dev": "tsx ../braid/src/cli.ts start --config braid.config.ts",
		"dev:stop": "tsx ../braid/src/cli.ts stop --config braid.config.ts",
		"dev:status": "tsx ../braid/src/cli.ts status --config braid.config.ts",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"check": "biome check --write"
	},
	"dependencies": {
		"braid": "workspace:*"
	}
}
